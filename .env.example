# API
HOST=0.0.0.0
PORT=3000

# Database setup
POSTGRES_DB=medical_data_hub
POSTGRES_USER=medical_data_hub_setup
POSTGRES_PASSWORD=example_setup_password
DATABASE_SETUP_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# API database
DATABASE_URL=postgresql://medical_data_hub_api:example_runtime_password@postgres:5432/${POSTGRES_DB}

# Keycloak database
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak_setup
KEYCLOAK_POSTGRES_PASSWORD=example_keycloak_database_password

# Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=example_keycloak_admin_password
KC_HOSTNAME=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/medical-data-hub
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/medical-data-hub/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=medical-data-hub-api
