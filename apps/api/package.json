	},
	"dependencies": {
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"express": "5.3.0",
		"jose": "6.2.15",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@types/express": "5.0.6",
		"prisma": "7.10.1"
	}
}
