{
	"realm": "medical-data-hub",
	"enabled": true,
	"adminPermissionsEnabled": true,
	"roles": {
		"client": {
			"medical-data-hub-api": [
				{ "name": "platform_administrator" },
				{ "name": "clinic_administrator" },
				{ "name": "reception" },
				{ "name": "healthcare_professional" }
			]
		}
	},
	"clients": [
		{
			"clientId": "medical-data-hub-api",
			"name": "Medical Data Hub API",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"secret": "medical_data_hub_api_dev",
			"standardFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": true,
			"fullScopeAllowed": false,
			"defaultClientScopes": ["roles"]
		},
		{
			"clientId": "medical-data-hub-postman",
			"name": "Medical Data Hub Postman (Development)",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": true,
			"standardFlowEnabled": true,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": false,
			"fullScopeAllowed": false,
			"redirectUris": ["https://oauth.pstmn.io/v1/browser-callback"],
			"attributes": {
				"pkce.code.challenge.method": "S256"
			},
			"defaultClientScopes": ["roles"],
			"protocolMappers": [
				{
					"name": "Include API as access token audience",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-audience-mapper",
					"config": {
						"included.client.audience": "medical-data-hub-api",
						"access.token.claim": "true",
						"id.token.claim": "false"
					}
				}
			]
		},
		{
			"clientId": "medical-data-hub-role-sync-worker",
			"name": "Medical Data Hub Role Synchronization Worker",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"secret": "medical_data_hub_role_sync_worker_dev",
			"standardFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": true,
			"fullScopeAllowed": false,
			"defaultClientScopes": ["roles"]
		},
		{
			"clientId": "admin-permissions",
			"authorizationServicesEnabled": true,
			"authorizationSettings": {
				"allowRemoteResourceManagement": false,
				"policyEnforcementMode": "ENFORCING",
				"policies": [
					{
						"name": "Match role synchronization worker account",
						"type": "user",
						"logic": "POSITIVE",
						"decisionStrategy": "UNANIMOUS",
						"config": {
							"users": "[\"service-account-medical-data-hub-role-sync-worker\"]"
						}
					},
					{
						"name": "Allow worker to change user role assignments",
						"type": "scope",
						"logic": "POSITIVE",
						"decisionStrategy": "UNANIMOUS",
						"config": {
							"defaultResourceType": "Users",
							"resources": "[\"Users\"]",
							"scopes": "[\"map-roles\"]",
							"applyPolicies": "[\"Match role synchronization worker account\"]"
						}
					},
					{
						"name": "Allow worker to view and assign API roles",
						"type": "scope",
						"logic": "POSITIVE",
						"decisionStrategy": "UNANIMOUS",
						"config": {
							"defaultResourceType": "Clients",
							"resources": "[\"medical-data-hub-api\"]",
							"scopes": "[\"view\",\"map-roles\"]",
							"applyPolicies": "[\"Match role synchronization worker account\"]"
						}
					}
				]
			}
		}
	],
	"clientScopeMappings": {
		"realm-management": [
			{
				"client": "medical-data-hub-api",
				"roles": ["view-users"]
			},
			{
				"client": "medical-data-hub-role-sync-worker",
				"roles": ["view-users", "query-clients"]
			}
		],
		"medical-data-hub-api": [
			{
				"client": "medical-data-hub-postman",
				"roles": [
					"platform_administrator",
					"clinic_administrator",
					"reception",
					"healthcare_professional"
				]
			}
		]
	},
	"users": [
		{
			"username": "service-account-medical-data-hub-api",
			"enabled": true,
			"serviceAccountClientId": "medical-data-hub-api",
			"clientRoles": {
				"realm-management": ["view-users"]
			}
		},
		{
			"username": "service-account-medical-data-hub-role-sync-worker",
			"enabled": true,
			"serviceAccountClientId": "medical-data-hub-role-sync-worker",
			"clientRoles": {
				"realm-management": ["view-users", "query-clients"]
			}
		},
		{
			"username": "platform-administrator",
			"enabled": true,
			"firstName": "Platform",
			"lastName": "Administrator",
			"email": "platform-administrator@example.test",
			"credentials": [
				{
					"type": "password",
					"value": "medical_data_hub_user_dev",
					"temporary": false
				}
			],
			"clientRoles": {
				"medical-data-hub-api": ["platform_administrator"]
			}
		},
		{
			"username": "clinic-administrator",
			"enabled": true,
			"firstName": "Clinic",
			"lastName": "Administrator",
			"email": "clinic-administrator@example.test",
			"credentials": [
				{
					"type": "password",
					"value": "medical_data_hub_user_dev",
					"temporary": false
				}
			],
			"clientRoles": {
				"medical-data-hub-api": ["clinic_administrator"]
			}
		},
		{
			"username": "reception",
			"enabled": true,
			"firstName": "Demo",
			"lastName": "Reception",
			"email": "reception@example.test",
			"credentials": [
				{
					"type": "password",
					"value": "medical_data_hub_user_dev",
					"temporary": false
				}
			],
			"clientRoles": {
				"medical-data-hub-api": ["reception"]
			}
		},
		{
			"username": "healthcare-professional",
			"enabled": true,
			"firstName": "Demo",
			"lastName": "Professional",
			"email": "healthcare-professional@example.test",
			"credentials": [
				{
					"type": "password",
					"value": "medical_data_hub_user_dev",
					"temporary": false
				}
			],
			"clientRoles": {
				"medical-data-hub-api": ["healthcare_professional"]
			}
		}
	]
}
