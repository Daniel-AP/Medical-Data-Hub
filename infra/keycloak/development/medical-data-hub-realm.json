{
	"realm": "medical-data-hub",
	"enabled": true,
	"adminPermissionsEnabled": true,
	"roles": {
		"client": {
			"medical-data-hub-api": [
				{ "name": "platform_administrator" },
				{ "name": "clinic_administrator" },
				{ "name": "reception" },
				{ "name": "healthcare_professional" }
			]
		}
	},
	"clients": [
		{
			"clientId": "medical-data-hub-api",
			"name": "Medical Data Hub API",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"secret": "medical_data_hub_api_dev",
			"standardFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": true,
			"fullScopeAllowed": false,
			"defaultClientScopes": ["roles"]
		},
		{
			"clientId": "medical-data-hub-postman",
			"name": "Medical Data Hub Postman (Development)",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": true,
			"standardFlowEnabled": true,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": false,
			"fullScopeAllowed": false,
			"redirectUris": ["https://oauth.pstmn.io/v1/browser-callback", "https://oauth.pstmn.io/v1/callback"],
			"attributes": { "pkce.code.challenge.method": "S256" },
			"defaultClientScopes": ["basic", "roles"],
			"protocolMappers": [
				{
					"name": "Include API as access token audience",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-audience-mapper",
					"config": {
						"included.client.audience": "medical-data-hub-api",
						"access.token.claim": "true",
						"id.token.claim": "false"
					}
				}
			]
		},
		{
			"clientId": "admin-permissions",
			"authorizationServicesEnabled": true,
			"authorizationSettings": {
				"allowRemoteResourceManagement": false,
				"policyEnforcementMode": "ENFORCING",
				"policies": [
					{
						"name": "Match API service account",
						"type": "user",
						"logic": "POSITIVE",
						"decisionStrategy": "UNANIMOUS",
						"config": { "users": "[\"service-account-medical-data-hub-api\"]" }
					},
					{
						"name": "Allow API to change user role assignments",
						"type": "scope",
						"logic": "POSITIVE",
						"decisionStrategy": "UNANIMOUS",
						"config": {
							"defaultResourceType": "Users",
							"resources": "[\"Users\"]",
							"scopes": "[\"map-roles\"]",
							"applyPolicies": "[\"Match API service account\"]"
						}
					},
					{
						"name": "Allow API to view and assign API roles",
						"type": "scope",
						"logic": "POSITIVE",
						"decisionStrategy": "UNANIMOUS",
						"config": {
							"defaultResourceType": "Clients",
							"resources": "[\"medical-data-hub-api\"]",
							"scopes": "[\"view\",\"map-roles\"]",
							"applyPolicies": "[\"Match API service account\"]"
						}
					}
				]
			}
		}
	],
	"clientScopeMappings": {
		"realm-management": [{ "client": "medical-data-hub-api", "roles": ["view-users", "query-clients"] }],
		"medical-data-hub-api": [
			{
				"client": "medical-data-hub-postman",
				"roles": ["platform_administrator", "clinic_administrator", "reception", "healthcare_professional"]
			}
		]
	},
